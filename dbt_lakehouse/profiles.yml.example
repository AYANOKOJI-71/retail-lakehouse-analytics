retail_lakehouse:
  target: local
  outputs:
    local:
      type: postgres
      host: postgres
      port: 5432
      user: "{{ env_var('POSTGRES_USER', 'lakehouse') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'lakehouse') }}"
      schema: analytics
      threads: 4
